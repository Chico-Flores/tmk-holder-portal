# Public (exposed to browser)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x16F67329271fac6922d7650f87EA59C4C4C3304D
NEXT_PUBLIC_CRONOS_RPC=https://evm.cronos.org
NEXT_PUBLIC_CHAIN_ID=25

# R2 Public URL for images (get this from Cloudflare R2 dashboard after enabling public access)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Private (server only) - Add your Cloudflare R2 credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=tmk-blender-files

# Supabase (Points System)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Cron Job Security
CRON_SECRET=your-random-secret-for-cron-auth
